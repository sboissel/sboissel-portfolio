---
import { getCollection, render } from 'astro:content';
import BlogArticle from '../layouts/BlogArticle.astro';

const [resume] = await getCollection('resume');

if (!resume) {
  throw new Error('Missing src/content/resume.mdx content entry.');
}

const { Content, headings } = await render(resume);

const cvPath = '/files/Sandrine_Boissel_CV_2026.pdf';
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const cvHref = `${basePath}${cvPath}`;
---

<BlogArticle
  post={resume}
  headings={headings}
  sidebar={{ enable: true, toc: true, ...resume.data.sidebar }}
  contentFont="ui"
>
  <div class="resume-download">
    <a class="resume-download-link" href={cvHref} download="Sandrine_Boissel_CV_2026.pdf">
      Download CV (PDF)
    </a>
  </div>
  <Content />
</BlogArticle>

<style>
  .resume-download {
    margin-bottom: 28px;
  }

  .resume-download-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border: 1px solid var(--paper-line);
    border-radius: 8px;
    background: var(--paper-surface);
    box-shadow: var(--paper-shadow);
    color: var(--paper-ink);
    font-family: var(--font-ui-label);
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition:
      transform 180ms ease,
      background 180ms ease,
      color 180ms ease;
  }

  .resume-download-link:hover {
    background: var(--paper-control-hover);
    color: var(--paper-accent);
    transform: translateY(-1px);
  }
</style>
