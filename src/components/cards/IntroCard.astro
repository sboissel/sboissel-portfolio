---
interface IntroHighlight {
  title: string;
  tagline?: string;
  description: string;
}

interface Intro {
  title: string;
  name: string;
  focus?: string;
  body: string[];
  highlightsHeading?: string;
  highlights?: IntroHighlight[];
}

interface Quote {
  text: string[];
}

const { intro, quote } = Astro.props as { intro: Intro; quote?: Quote };
const highlights = intro.highlights ?? [];
---

<article class="glass-card intro-card">
  <div class="intro-copy">
    <h2>
      <span aria-hidden="true">Hi,</span>
      {intro.title.replace(intro.name, '')}<em>{intro.name}</em>
    </h2>
    {intro.focus && <p class="intro-focus">{intro.focus}</p>}
    {
      quote && (
        <blockquote>
          <span>- {quote.text.slice(0, 2).join(' ')}</span>
          <span>{quote.text.slice(2).join(' ')}</span>
        </blockquote>
      )
    }
    {intro.body.map((paragraph) => <p>{paragraph}</p>)}
    {
      highlights.length > 0 && (
        <section class="intro-highlights" aria-label={intro.highlightsHeading || 'Focus areas'}>
          {intro.highlightsHeading && <h3>{intro.highlightsHeading}</h3>}
          <ul>
            {highlights.map((item) => (
              <li>
                <p class="highlight-title">
                  {item.title}
                  {item.tagline && <span class="highlight-tagline"> — {item.tagline}</span>}
                </p>
                <p class="highlight-description">{item.description}</p>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</article>

<style>
  .intro-card {
    display: flex;
    flex-direction: column;
    min-height: 280px;
    padding: 0;
    border-color: transparent;
    background: transparent;
    box-shadow: none;
  }

  .intro-card:hover {
    border-color: transparent;
    box-shadow: none;
    transform: none;
  }

  .intro-copy {
    position: relative;
    z-index: 1;
    display: flex;
    width: 100%;
    max-width: none;
    flex-direction: column;
    align-items: flex-start;
  }

  h2 {
    margin: 0 0 18px;
    color: var(--paper-ink);
    max-width: none;
    font-size: clamp(2.2rem, 4vw, 3.35rem);
    line-height: 1.04;
    white-space: nowrap;
  }

  h2 span {
    margin-right: 0.35rem;
    color: var(--paper-accent);
    font-style: normal;
  }

  h2 em {
    color: var(--paper-accent);
    font-style: italic;
  }

  .intro-focus {
    margin: 0 0 14px;
    color: var(--paper-ink);
    max-width: 66ch;
    font-family: var(--font-ui-label);
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.5;
  }

  blockquote {
    display: block;
    max-width: 52ch;
    margin: 0 0 26px auto;
    padding: 0;
    border: 0;
    color: var(--paper-ink-soft);
    font-family: var(--font-note);
    font-size: clamp(0.96rem, 1.35vw, 1.12rem);
    font-style: italic;
    line-height: 1.72;
    text-align: right;
  }

  blockquote span {
    display: block;
  }

  p {
    width: 100%;
    margin: 0 0 12px;
    color: var(--paper-ink);
    max-width: 66ch;
    font-size: 1.02rem;
    line-height: 1.92;
  }

  .intro-highlights {
    width: 100%;
    max-width: 66ch;
    margin-top: 18px;
  }

  .intro-highlights h3 {
    margin: 0 0 14px;
    color: var(--paper-ink);
    font-family: var(--font-ui-label);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .intro-highlights ul {
    display: grid;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .intro-highlights li {
    padding-top: 16px;
    border-top: 1px solid var(--paper-line);
  }

  .highlight-title {
    margin: 0 0 6px;
    color: var(--paper-ink);
    font-family: var(--font-ui-label);
    font-size: 0.96rem;
    font-weight: 600;
    line-height: 1.5;
  }

  .highlight-tagline {
    color: var(--paper-ink-soft);
    font-weight: 500;
  }

  .highlight-description {
    margin: 0;
    color: var(--paper-ink-soft);
    font-size: 0.96rem;
    line-height: 1.75;
  }

  .intro-highlights li:last-child .highlight-description {
    margin-bottom: 0;
  }

  @media (max-width: 640px) {
    .intro-card {
      padding: 0;
    }

    h2 {
      font-size: 1.7rem;
      white-space: normal;
    }

    blockquote {
      margin-left: 0;
      text-align: left;
    }
  }
</style>
