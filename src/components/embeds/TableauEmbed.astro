---
interface Props {
  embedUrl: string;
  shareUrl: string;
  title?: string;
  width?: number;
  height?: number;
}

const {
  embedUrl,
  shareUrl,
  title = "Runner's Dashboard",
  width = 1016,
  height = 900,
} = Astro.props;
---

<div class="tableau-embed" data-native-width={width} data-native-height={height}>
  <div class="tableau-embed__viewport">
    <iframe
      src={embedUrl}
      title={title}
      width={width}
      height={height}
      allowfullscreen
      loading="lazy"
      scrolling="no"
      tabindex="-1"></iframe>
  </div>

  <p class="tableau-embed__note">
    <a href={shareUrl} target="_blank" rel="noopener noreferrer">View on Tableau Public</a>{' '}
    for the full interactive experience if the embed does not load here.
  </p>
</div>

<style define:vars={{ tableauWidth: `${width}px`, tableauHeight: `${height}px` }}>
  .tableau-embed {
    width: 100%;
    max-width: 100%;
    margin: 28px 0;
    border: 1px solid var(--paper-line);
    border-radius: 8px;
    background: var(--paper-surface);
    box-shadow: var(--paper-shadow);
  }

  .tableau-embed__viewport {
    width: 100%;
    overflow: hidden;
  }

  .tableau-embed iframe {
    display: block;
    width: var(--tableauWidth);
    height: var(--tableauHeight);
    border: 0;
    overflow: hidden;
    transform-origin: top left;
  }

  .tableau-embed__note {
    margin: 0;
    padding: 10px 14px;
    border-top: 1px solid var(--paper-line);
    color: var(--paper-ink-soft);
    font-size: 0.82rem;
    line-height: 1.6;
    text-align: center;
  }

  .tableau-embed__note a {
    color: var(--paper-accent);
    text-decoration: none;
  }

  .tableau-embed__note a:hover {
    text-decoration: underline;
  }
</style>

<script>
  const MIN_VIEWPORT_HEIGHT = 200;
  const MAX_VIEWPORT_HEIGHT_RATIO = 0.85;

  function getAvailableHeight(note: HTMLElement | null): number {
    const noteHeight = note?.offsetHeight ?? 0;
    const maxByViewport = window.innerHeight * MAX_VIEWPORT_HEIGHT_RATIO - noteHeight;

    return Math.max(MIN_VIEWPORT_HEIGHT, maxByViewport);
  }

  function scaleTableauEmbeds() {
    document.querySelectorAll<HTMLElement>('.tableau-embed').forEach((embed) => {
      const viewport = embed.querySelector<HTMLElement>('.tableau-embed__viewport');
      const iframe = embed.querySelector<HTMLIFrameElement>('iframe');
      const note = embed.querySelector<HTMLElement>('.tableau-embed__note');
      if (!viewport || !iframe) return;

      const nativeWidth = Number(embed.dataset.nativeWidth) || 1016;
      const nativeHeight = Number(embed.dataset.nativeHeight) || 900;
      const containerWidth = viewport.clientWidth;
      const availableHeight = getAvailableHeight(note);

      const widthScale = containerWidth / nativeWidth;
      const heightScale = availableHeight / nativeHeight;
      const scale = Math.min(widthScale, heightScale);
      const scaledWidth = nativeWidth * scale;
      const offsetX = Math.max(0, (containerWidth - scaledWidth) / 2);

      iframe.style.transform = `translateX(${offsetX}px) scale(${scale})`;
      viewport.style.height = `${nativeHeight * scale}px`;
    });
  }

  let rafId = 0;
  function scheduleScale() {
    cancelAnimationFrame(rafId);
    rafId = requestAnimationFrame(scaleTableauEmbeds);
  }

  scaleTableauEmbeds();

  window.addEventListener('resize', scheduleScale, { passive: true });

  if ('ResizeObserver' in window) {
    const observer = new ResizeObserver(scheduleScale);
    document.querySelectorAll('.tableau-embed').forEach((embed) => {
      observer.observe(embed);
    });
  }
</script>
