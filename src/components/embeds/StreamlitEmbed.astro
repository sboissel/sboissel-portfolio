---
interface Props {
  embedUrl: string;
  shareUrl: string;
  title?: string;
  width?: number;
  height?: number;
}

const {
  embedUrl,
  shareUrl,
  title = 'Streamlit dashboard',
  width = 1180,
  height = 850,
} = Astro.props;
---

<div class="streamlit-embed" data-native-width={width} data-native-height={height}>
  <div class="streamlit-embed__viewport">
    <iframe
      src={embedUrl}
      title={title}
      width={width}
      height={height}
      allowfullscreen
      loading="lazy"
      scrolling="no"
      tabindex="-1"></iframe>
  </div>

  <p class="streamlit-embed__note">
    <a href={shareUrl} target="_blank" rel="noopener noreferrer">Open Streamlit app</a>{' '}
    in a new tab for the full interactive experience if the embed does not load here.
  </p>
</div>

<style define:vars={{ streamlitWidth: `${width}px`, streamlitHeight: `${height}px` }}>
  /* Match the Streamlit dashboard block-container width so the embed can scale 1:1. */
  :global(.blog-detail-page .article-content:has(.streamlit-embed)) {
    max-width: 1180px;
    width: min(100%, 1180px);
  }

  .streamlit-embed {
    width: 100%;
    max-width: 100%;
    margin: 28px 0;
    border: 1px solid var(--paper-line);
    border-radius: 8px;
    background: var(--paper-surface);
    box-shadow: var(--paper-shadow);
    overflow: hidden;
  }

  .streamlit-embed__viewport {
    width: 100%;
    overflow: hidden;
  }

  .streamlit-embed iframe {
    display: block;
    width: var(--streamlitWidth);
    height: var(--streamlitHeight);
    border: 0;
    overflow: hidden;
    transform-origin: top left;
  }

  .streamlit-embed__note {
    margin: 0;
    padding: 10px 14px;
    border-top: 1px solid var(--paper-line);
    color: var(--paper-ink-soft);
    font-size: 0.82rem;
    line-height: 1.6;
    text-align: center;
  }

  .streamlit-embed__note a {
    color: var(--paper-accent);
    text-decoration: none;
  }

  .streamlit-embed__note a:hover {
    text-decoration: underline;
  }
</style>

<script>
  function scaleStreamlitEmbeds() {
    document.querySelectorAll<HTMLElement>('.streamlit-embed').forEach((embed) => {
      const viewport = embed.querySelector<HTMLElement>('.streamlit-embed__viewport');
      const iframe = embed.querySelector<HTMLIFrameElement>('iframe');
      if (!viewport || !iframe) return;

      const nativeWidth = Number(embed.dataset.nativeWidth) || 1180;
      const nativeHeight = Number(embed.dataset.nativeHeight) || 850;
      const containerWidth = viewport.clientWidth;

      const scale = containerWidth / nativeWidth;
      const scaledWidth = nativeWidth * scale;
      const offsetX = Math.max(0, (containerWidth - scaledWidth) / 2);

      iframe.style.transform = `translateX(${offsetX}px) scale(${scale})`;
      viewport.style.height = `${nativeHeight * scale}px`;
    });
  }

  let rafId = 0;
  function scheduleScale() {
    cancelAnimationFrame(rafId);
    rafId = requestAnimationFrame(scaleStreamlitEmbeds);
  }

  scaleStreamlitEmbeds();

  window.addEventListener('resize', scheduleScale, { passive: true });

  if ('ResizeObserver' in window) {
    const observer = new ResizeObserver(scheduleScale);
    document.querySelectorAll('.streamlit-embed').forEach((embed) => {
      observer.observe(embed);
    });
  }
</script>
