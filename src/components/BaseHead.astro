---
import type { ImageMetadata } from 'astro';
import ThemeBaseHead from '@navfolio/theme-default/components/BaseHead.astro';
import FallbackImage from '../assets/figure/fail-loading-image.png';
import { getSiteConfig } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata | string;
}

const { title, description, image } = Astro.props;
const { site, fonts } = await getSiteConfig();
---

<script is:inline>
  (() => {
    const storageKey = 'navfolio-theme';
    const defaultTheme = 'light';
    const root = document.documentElement;

    const readTheme = () => {
      try {
        return localStorage.getItem(storageKey) === 'dark' ? 'dark' : defaultTheme;
      } catch {
        return defaultTheme;
      }
    };

    const applyTheme = (theme) => {
      root.dataset.theme = theme;
      root.style.colorScheme = theme;
      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute('content', theme === 'dark' ? '#171b18' : '#fdfdf9');
    };

    const theme = readTheme();
    applyTheme(theme);

    try {
      if (localStorage.getItem(storageKey) !== 'dark') {
        localStorage.setItem(storageKey, defaultTheme);
      }
    } catch {}
  })();
</script>

<ThemeBaseHead
  title={title}
  description={description}
  image={image}
  fallbackImage={FallbackImage}
  site={site}
  fonts={fonts}
/>

<script is:inline>
  (() => {
    const storageKey = 'navfolio-theme';
    const defaultTheme = 'light';

    const syncTheme = () => {
      const theme = (() => {
        try {
          return localStorage.getItem(storageKey) === 'dark' ? 'dark' : defaultTheme;
        } catch {
          return defaultTheme;
        }
      })();

      document.documentElement.dataset.theme = theme;
      document.documentElement.style.colorScheme = theme;
      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute('content', theme === 'dark' ? '#171b18' : '#fdfdf9');
    };

    syncTheme();
    document.addEventListener('astro:page-load', syncTheme);
  })();
</script>
