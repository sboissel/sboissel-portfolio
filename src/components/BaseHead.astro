---
import type { ImageMetadata } from 'astro';
import SiteBaseHead from './theme/SiteBaseHead.astro';
import FallbackImage from '../assets/figure/fail-loading-image.png';
import { getSiteConfig } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata | string;
}

const { title, description, image } = Astro.props;
const { site, fonts } = await getSiteConfig();
---

<script is:inline>
  (() => {
    const storageKey = 'navfolio-theme';
    const defaultTheme = 'light';
    const root = document.documentElement;

    const readTheme = () => {
      try {
        return localStorage.getItem(storageKey) === 'dark' ? 'dark' : defaultTheme;
      } catch {
        return defaultTheme;
      }
    };

    const syncThemeControls = (theme) => {
      const nextTheme = theme === 'dark' ? 'dark' : 'light';
      const toggleLabel = nextTheme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme';

      root.dataset.theme = nextTheme;
      root.style.colorScheme = nextTheme;
      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute('content', nextTheme === 'dark' ? '#171b18' : '#fdfdf9');

      for (const button of document.querySelectorAll('[data-theme-toggle]')) {
        button.setAttribute('aria-label', toggleLabel);
        button.setAttribute('title', toggleLabel);
      }
    };

    const persistTheme = (theme) => {
      try {
        localStorage.setItem(storageKey, theme);
      } catch {}
    };

    const theme = readTheme();
    syncThemeControls(theme);

    if (readTheme() !== 'dark') {
      persistTheme(defaultTheme);
    }

    if (!window.__navfolioTheme) {
      window.__navfolioTheme = {
        toggle() {
          const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark';
          syncThemeControls(nextTheme);
          persistTheme(nextTheme);
        },
      };
    }

    if (window.__navfolioThemeControlsReady) {
      return;
    }

    window.__navfolioThemeControlsReady = true;

    document.addEventListener('click', (event) => {
      const toggle = event.target.closest?.('[data-theme-toggle]');
      if (toggle) window.__navfolioTheme.toggle();
    });
  })();
</script>

<SiteBaseHead
  title={title}
  description={description}
  image={image}
  fallbackImage={FallbackImage}
  site={site}
  fonts={fonts}
/>
