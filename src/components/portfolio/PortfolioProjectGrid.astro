---
import {
  Box,
  Code2,
  Database,
  ExternalLink,
  FileCode2,
  Github,
  Globe2,
  Layers3,
  Palette,
  Rocket,
  Sparkles,
  Terminal,
  WandSparkles,
} from 'lucide-astro';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../FormattedDate.astro';

type PortfolioItem = CollectionEntry<'portfolioItems'>;

interface Props {
  projects: PortfolioItem[];
  basePath?: string;
}

const { projects, basePath = '/portfolio' } = Astro.props;
const siteBase = import.meta.env.BASE_URL.replace(/\/$/, '');

const projectIcons = {
  github: Github,
  box: Box,
  'code-2': Code2,
  database: Database,
  'file-code-2': FileCode2,
  'globe-2': Globe2,
  'layers-3': Layers3,
  palette: Palette,
  rocket: Rocket,
  sparkles: Sparkles,
  terminal: Terminal,
  'wand-sparkles': WandSparkles,
};

function withBase(href: string) {
  return `${siteBase}${href.startsWith('/') ? href : `/${href}`}`;
}
---

{
  projects.length > 0 ? (
    <section class="project-grid">
      {projects.map((project) => {
        const ProjectIcon = projectIcons[project.data.icon] ?? Layers3;
        const projectHref = withBase(`${basePath}/${project.id}/`);

        return (
          <article
            class="project-card"
            data-project-tools={project.data.tools.join(' ')}
            style={
              project.data.iconColor ? `--project-icon-color: ${project.data.iconColor}` : undefined
            }
          >
            <div class="project-card-heading">
              <ProjectIcon class="project-icon" size={22} strokeWidth={1.55} aria-hidden="true" />
              <h3>
                <a href={projectHref}>{project.data.title}</a>
              </h3>
            </div>
            <p>{project.data.description}</p>
            <footer class="project-card-footer">
              <span class="project-meta">
                <FormattedDate date={project.data.date} />
              </span>
              {project.data.tools.length > 0 && (
                <span class="project-tags">
                  {project.data.tools.map((tool) => (
                    <small>{tool}</small>
                  ))}
                </span>
              )}
            </footer>
          </article>
        );
      })}
    </section>
  ) : (
    <p class="project-empty">No projects yet.</p>
  )
}

<style>
  .project-meta,
  .project-tags small,
  .project-empty {
    font-family: var(--font-ui-label);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(12px, 2vw, 22px);
    margin-top: 18px;
  }

  .project-card {
    display: grid;
    gap: 14px;
    min-height: 160px;
    padding: 16px;
    color: var(--paper-ink);
    font-family: var(--font-ui-label);
    border-radius: 8px;
    transition:
      transform 180ms ease,
      background 180ms ease;
  }

  .project-card:hover {
    background: var(--paper-control-hover);
    transform: translateY(-1px);
  }

  .project-card-heading {
    display: flex;
    gap: 11px;
    align-items: center;
  }

  .project-icon {
    flex: none;
    color: var(--project-icon-color, var(--paper-accent));
  }

  .project-card h3 {
    margin: 0;
    color: var(--paper-ink);
    font-family: var(--font-ui-label);
    font-size: 1.18rem;
    line-height: 1.28;
  }

  .project-card h3 a {
    color: inherit;
    text-decoration: none;
  }

  .project-card h3 a:hover {
    color: var(--paper-accent);
  }

  .project-card p {
    margin: 0;
    color: var(--paper-ink-soft);
    line-height: 1.78;
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .project-meta {
    color: var(--paper-ink-faint);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .project-card-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    align-self: end;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .project-tags small {
    padding: 3px 8px;
    border: 1px solid var(--paper-line);
    border-radius: 999px;
    color: var(--paper-ink-soft);
    font-size: 0.74rem;
  }

  .project-empty {
    margin: 18px 0 0;
    color: var(--paper-ink-soft);
    font-size: 0.95rem;
  }

  @media (max-width: 720px) {
    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
